# 复制为 local.env 并填写；或直接在 shell 里 export 这些变量
# 飞书自建应用凭据（auth 节点：OAuth 换取/刷新）
export AUTH_FEISHU_APP_ID=cli_xxxxxxxxxxxx
export AUTH_FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# bot 节点凭据（IM 长连接收发；与上面同一个自建应用）
export BOT_APP_ID=cli_xxxxxxxxxxxx
export BOT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 流式 STT 模型目录（sherpa-onnx，下载方式见 new/docs/LOCAL_TESTING.md）
export STT_MODEL_DIR="$HOME/models/sherpa-onnx-x-asr-480ms-streaming-zipformer-transducer-zh-en-punct-int8-2026-06-05"

# 模型执行：fake（本地假模型，默认）或 opencode（真实 GLM，需本机 opencode 登录）
export REMOTE_BACKEND=fake

# auth 的对外回调基址：本地测试=本机回环（须与飞书后台注册的
# redirect URI 精确一致）
export AUTH_BASE_URL=http://127.0.0.1:8381

# 远程访问（可选）：默认自动探测本机 IP（en0/en1），所有服务绑 0.0.0.0。
# 显式指定示例：export HOST_IP=192.168.1.10
# 录制器命令里的 ingest 地址由此生成（也可直接覆盖 INGEST_URL）：
# export INGEST_URL=ws://192.168.1.10:8400/ingest
