# Shell syntax; copy to scripts/prod.env and chmod 600.
export AUTH_FEISHU_APP_ID='cli_replace_me'
export AUTH_FEISHU_APP_SECRET='replace_me'
export BOT_APP_ID='cli_replace_me'
export BOT_APP_SECRET='replace_me'
# 运维台（admin-site）飞书登录白名单：逗号分隔的飞书 user_id（登录名）。
# 必填；未配置或为空时 admin-site 拒绝启动。
export ADMIN_USERS='kai.han,pengw.wang'
export STT_MODEL_DIR='/absolute/path/to/stt-model'
export NOAM_BIN='/absolute/path/to/noam'
export OPENCODE_BIN='/absolute/path/to/opencode'
# Optional: OpenCode model ('<provider>/<model>', default zai-coding-plan/glm-5.3),
# auth.json, Jira URL, and custom skills directory.
# export OPENCODE_MODEL='zai-coding-plan/glm-5.3'
# export OPENCODE_AUTH='/absolute/path/to/auth.json'
# Required for providers outside opencode's built-in catalog (e.g. nio):
# export OPENCODE_PROVIDER_CONFIG='/absolute/path/to/opencode-provider.json'
# export MODELSIGHT_API_KEY='...'
# export JIRA_URL='https://jira.example.com'
# 回复中把白名单项目的工单号渲染为 Jira 链接（逗号分隔；留空不启用）
# export JIRA_PROJECT_KEYS='NT3VFTVDR,NT2'
# export SKILLS_DIR='/absolute/path/to/skills'
export PUBLIC_BASE_URL='http://meeting-advisor.nioint.com'
export INGEST_URL='ws://meeting-advisor.nioint.com:8400/ingest'
export REMOTE_BACKEND='opencode'
